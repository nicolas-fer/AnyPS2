ANYPS2_OP(MTSAH,    "mtsah",    FMT_RS_SIMM,        0,                         0, 0)

// --- MMI (opcode 28, campo funct) ------------------------------------------
ANYPS2_OP(MADD,     "madd",     FMT_RDOPT_RS_RT,    MMI,                       0, Z_SA)
ANYPS2_OP(MADDU,    "maddu",    FMT_RDOPT_RS_RT,    MMI,                       0, Z_SA)
