ANYPS2_OP(LWR,      "lwr",      FMT_MEM_GPR,        LD | UNA,                  4, 0)
ANYPS2_OP(LWU,      "lwu",      FMT_MEM_GPR,        LD,                        4, 0)
ANYPS2_OP(SB,       "sb",       FMT_MEM_GPR,        ST,                        1, 0)
ANYPS2_OP(SH,       "sh",       FMT_MEM_GPR,        ST,                        2, 0)
ANYPS2_OP(SWL,      "swl",      FMT_MEM_GPR,        ST | UNA,                  4, 0)
ANYPS2_OP(SW,       "sw",       FMT_MEM_GPR,        ST,                        4, 0)
ANYPS2_OP(SDL,      "sdl",      FMT_MEM_GPR,        ST | UNA,                  8, 0)
ANYPS2_OP(SDR,      "sdr",      FMT_MEM_GPR,        ST | UNA,                  8, 0)
ANYPS2_OP(SWR,      "swr",      FMT_MEM_GPR,        ST | UNA,                  4, 0)
ANYPS2_OP(CACHE,    "cache",    FMT_CACHE,          PRV,                       0, 0)
ANYPS2_OP(LWC1,     "lwc1",     FMT_MEM_FPR,        LD | FPU,                  4, 0)
ANYPS2_OP(PREF,     "pref",     FMT_CACHE,          0,                         0, 0)
ANYPS2_OP(LQC2,     "lqc2",     FMT_MEM_VF,         LD | VU0,                 16, 0)
ANYPS2_OP(LD,       "ld",       FMT_MEM_GPR,        LD,                        8, 0)
ANYPS2_OP(SWC1,     "swc1",     FMT_MEM_FPR,        ST | FPU,                  4, 0)
ANYPS2_OP(SQC2,     "sqc2",     FMT_MEM_VF,         ST | VU0,                 16, 0)
ANYPS2_OP(SD,       "sd",       FMT_MEM_GPR,        ST,                        8, 0)

