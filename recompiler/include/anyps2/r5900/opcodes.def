ANYPS2_OP(SUBU,     "subu",     FMT_RD_RS_RT,       0,                         0, Z_SA)
ANYPS2_OP(AND,      "and",      FMT_RD_RS_RT,       0,                         0, Z_SA)
ANYPS2_OP(OR,       "or",       FMT_RD_RS_RT,       0,                         0, Z_SA)
