// Tabela mestre de instruções do MIPS R5900 (Emotion Engine).
//
// Este arquivo é um X-macro: quem o inclui define ANYPS2_OP antes.
//
//   ANYPS2_OP(Id, "mnemônico", Formato, Flags, TamanhoMem, MascaraZero)
//
// - Id          : nome do enumerador em r5900::Op.
// - mnemônico   : mnemônico base no estilo GNU binutils. Instruções com
//                 sufixos dinâmicos (VU0 .xyzw, broadcast, .i em QMFC2...)
//                 recebem o sufixo no disassembler.
// - Formato     : sintaxe dos operandos (enum r5900::Format).
// - Flags       : propriedades semânticas (enum r5900::Flag), combinadas com |.
// - TamanhoMem  : bytes acessados por loads/stores (0 se não acessa memória).
// - MascaraZero : bits que, numa codificação canônica, devem ser zero. O
//                 hardware ignora esses bits; o decodificador marca a
//                 instrução como "não canônica" quando algum está ligado.
//
// A ordem das entradas não importa para a decodificação (que é feita por
// tabelas de despacho em decoder.cpp); ela segue os mapas de opcode do
// manual "EE Core Instruction Set Manual".

// clang-format off

// --- Inválida (sempre a primeira entrada, valor 0) --------------------------
ANYPS2_OP(Invalid,  "<inválida>", FMT_NONE, 0, 0, 0)

// --- Opcodes primários -----------------------------------------------------
ANYPS2_OP(J,        "j",        FMT_JUMP,           JMP | DLY,                 0, 0)
ANYPS2_OP(JAL,      "jal",      FMT_JUMP,           JMP | LNK | DLY,           0, 0)
ANYPS2_OP(BEQ,      "beq",      FMT_RS_RT_BRANCH,   BR | DLY,                  0, 0)
ANYPS2_OP(BNE,      "bne",      FMT_RS_RT_BRANCH,   BR | DLY,                  0, 0)
ANYPS2_OP(BLEZ,     "blez",     FMT_RS_BRANCH,      BR | DLY,                  0, Z_RT)
ANYPS2_OP(BGTZ,     "bgtz",     FMT_RS_BRANCH,      BR | DLY,                  0, Z_RT)
ANYPS2_OP(ADDI,     "addi",     FMT_RT_RS_SIMM,     OVF,                       0, 0)
ANYPS2_OP(ADDIU,    "addiu",    FMT_RT_RS_SIMM,     0,                         0, 0)
ANYPS2_OP(SLTI,     "slti",     FMT_RT_RS_SIMM,     0,                         0, 0)
ANYPS2_OP(SLTIU,    "sltiu",    FMT_RT_RS_SIMM,     0,                         0, 0)
ANYPS2_OP(ANDI,     "andi",     FMT_RT_RS_UIMM,     0,                         0, 0)
ANYPS2_OP(ORI,      "ori",      FMT_RT_RS_UIMM,     0,                         0, 0)
ANYPS2_OP(XORI,     "xori",     FMT_RT_RS_UIMM,     0,                         0, 0)
ANYPS2_OP(LUI,      "lui",      FMT_RT_UIMM,        0,                         0, Z_RS)
ANYPS2_OP(BEQL,     "beql",     FMT_RS_RT_BRANCH,   BR | LKL | DLY,            0, 0)
ANYPS2_OP(BNEL,     "bnel",     FMT_RS_RT_BRANCH,   BR | LKL | DLY,            0, 0)
ANYPS2_OP(BLEZL,    "blezl",    FMT_RS_BRANCH,      BR | LKL | DLY,            0, Z_RT)
ANYPS2_OP(BGTZL,    "bgtzl",    FMT_RS_BRANCH,      BR | LKL | DLY,            0, Z_RT)
ANYPS2_OP(DADDI,    "daddi",    FMT_RT_RS_SIMM,     OVF,                       0, 0)
ANYPS2_OP(DADDIU,   "daddiu",   FMT_RT_RS_SIMM,     0,                         0, 0)
ANYPS2_OP(LDL,      "ldl",      FMT_MEM_GPR,        LD | UNA,                  8, 0)
ANYPS2_OP(LDR,      "ldr",      FMT_MEM_GPR,        LD | UNA,                  8, 0)
ANYPS2_OP(LQ,       "lq",       FMT_MEM_GPR,        LD,                       16, 0)
