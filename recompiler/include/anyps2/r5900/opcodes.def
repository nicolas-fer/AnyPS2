ANYPS2_OP(MFSA,     "mfsa",     FMT_RD,             0,                         0, Z_RS | Z_RT | Z_SA)
ANYPS2_OP(MTSA,     "mtsa",     FMT_RS,             0,                         0, Z_RT | Z_RD | Z_SA)
ANYPS2_OP(SLT,      "slt",      FMT_RD_RS_RT,       0,                         0, Z_SA)
ANYPS2_OP(SLTU,     "sltu",     FMT_RD_RS_RT,       0,                         0, Z_SA)
