ANYPS2_OP(LB,       "lb",       FMT_MEM_GPR,        LD,                        1, 0)
ANYPS2_OP(LH,       "lh",       FMT_MEM_GPR,        LD,                        2, 0)
ANYPS2_OP(LWL,      "lwl",      FMT_MEM_GPR,        LD | UNA,                  4, 0)
ANYPS2_OP(LW,       "lw",       FMT_MEM_GPR,        LD,                        4, 0)
